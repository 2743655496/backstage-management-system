# 是否开启 Django DEBUG 模式
# True：开发环境（显示错误堆栈）
# False：生产环境（隐藏错误信息）
DEBUG=True

# ===========================
# ALLOWED_HOSTS 配置
# ===========================
# 允许访问 Django 的域名/IP 列表
# 写法 1：允许所有（开发环境常用）
# ALLOWED_HOSTS=*
#
# 写法 2：指定多个域名/IP，用逗号分隔
# ALLOWED_HOSTS=127.0.0.1,localhost,192.168.10.143
#
# 下面是示例（你可以按需修改）
ALLOWED_HOSTS=*

# ===========================
# CORS 跨域配置
# ===========================

# 写法 1：允许所有跨域（开发环境常用）
# CORS_ORIGINS=*

# 写法 2：指定允许跨域的域名（生产环境推荐）
# CORS_ORIGINS=http://localhost:8080,http://192.168.10.143:8080

# 你当前开发环境建议使用：
CORS_ORIGINS=*

# ===========================
# MySQL 数据库配置
# ===========================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=111111
MYSQL_DB=backstage

# ===========================
# Redis 配置
# ===========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ===========================
# JWT 密钥（务必保密）
# ===========================
JWT_SECRET_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
