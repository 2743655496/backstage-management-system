# ===========================
# 基础配置（生产环境）
# ===========================

# 关闭 Django 调试模式（生产环境必须 False）
DEBUG=False

# 只允许前端域名访问后端（生产环境必须严格限制）
# 示例：ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.10.143

# 只允许前端域名跨域访问（生产环境必须严格限制）
# 示例：CORS_ORIGINS=https://yourdomain.com
CORS_ORIGINS=https://192.168.10.143

# ===========================
# MySQL 数据库配置（生产环境）
# ===========================
MYSQL_HOST=192.168.10.143
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=111111
MYSQL_DB=backstage

# ===========================
# Redis 配置（生产环境）
# ===========================
REDIS_HOST=192.168.10.143
REDIS_PORT=6379
REDIS_DB=0

# ===========================
# JWT 密钥（生产环境必须更换为强随机值）
# ===========================
JWT_SECRET_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
