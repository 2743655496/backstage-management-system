# ===========================
# 基础配置（生产环境）
# ===========================

# 关闭 Django 调试模式（生产环境必须 False）
DEBUG=False

# 服务器真实 IP 或域名
HOST=your-server-ip-or-domain.com

# 只允许前端域名访问后端（生产环境必须严格限制）
# 示例：ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com

# 只允许前端域名跨域访问（生产环境必须严格限制）
# 示例：CORS_ORIGINS=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# ===========================
# MySQL 数据库配置（生产环境）
# ===========================
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=backstage

# ===========================
# Redis 配置（生产环境）
# ===========================
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_DB=0

# ===========================
# JWT 密钥（生产环境必须更换为强随机值）
# ===========================
JWT_SECRET_KEY=your-strong-random-secret-key
